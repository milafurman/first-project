.lf-section-hero img[src*="hero-media"]{max-height:560px!important;animation:float 5s ease-in-out infinite;will-change:transform}
.lf-card .aspect-square{background:#fff!important}
.lf-card{transition:transform .3s cubic-bezier(.2,.7,.3,1),box-shadow .3s ease,border-color .2s ease}
.lf-card:hover{transform:translateY(-6px);border-color:#2365CD;box-shadow:0 22px 44px -20px rgba(14,24,48,.38)}
.lf-card img{transition:transform .45s cubic-bezier(.2,.7,.3,1)}
.lf-card:hover img{transform:scale(1.07) translateY(-4px)}
.lf-section-quality .rounded-2xl{transition:transform .3s cubic-bezier(.2,.7,.3,1),box-shadow .3s ease,background-color .3s ease}
.lf-section-quality .rounded-2xl:hover{transform:translateY(-5px);background-color:rgba(35,101,205,.12);box-shadow:0 20px 40px -20px rgba(35,101,205,.55)}
.lf-section-howItWorks .rounded-2xl{transition:transform .3s cubic-bezier(.2,.7,.3,1),box-shadow .3s ease,border-color .2s ease}
.lf-section-howItWorks .rounded-2xl:hover{transform:translateY(-5px);border-color:#2365CD;box-shadow:0 20px 40px -20px rgba(14,24,48,.3)}
a.inline-flex,button.inline-flex{transition:transform .2s ease,box-shadow .25s ease,filter .2s ease}
a.inline-flex:hover,button.inline-flex:hover{transform:translateY(-2px);filter:brightness(1.06)}
.lf-section-comparison{display:none}
@media (prefers-reduced-motion:reduce){.lf-section-hero img[src*="hero-media"]{animation:none}}
/* the theme washes the hero photo out under a flat 72/55/78% white scrim, which is enough to hide the product standing in it. Swapped for a horizontal one: opaque under the headline on the left, then clearing fast so the vials on the right read at full strength. A phone has no left and right to trade, so it keeps an even scrim. */
.lf-section-hero .z-0>div.absolute.inset-0{background-image:linear-gradient(90deg,rgba(255,255,255,.9) 0%,rgba(255,255,255,.84) 30%,rgba(255,255,255,.55) 46%,rgba(255,255,255,.18) 62%,rgba(255,255,255,.06) 100%)!important}
@media(max-width:767px){.lf-section-hero .z-0>div.absolute.inset-0{background-image:linear-gradient(rgba(255,255,255,.8) 0%,rgba(255,255,255,.66) 50%,rgba(255,255,255,.84) 100%)!important}}